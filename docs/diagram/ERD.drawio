        <mxCell id="464" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#666666;" value="UNIQUE(user_id, agreement_type) — 사용자 × 약관 1행.&#xa;약관이 늘어도 컬럼 추가가 없고 항목별 동의 시각이 남는다." vertex="1">
          <mxGeometry height="40" width="400" x="1520" y="280" as="geometry" />
        </mxCell>
        <mxCell id="465" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#666666;" value="온보딩 원본 답변만 보관. baseline·계수는 전부 파생값이라&#xa;저장하지 않는다 → daily_score 가 버전과 함께 보관." vertex="1">
          <mxGeometry height="40" width="400" x="80" y="1300" as="geometry" />
        </mxCell>
        <mxCell id="466" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#666666;" value="UNIQUE(author_id, log_date) — 1인 1일 1건" vertex="1">
          <mxGeometry height="20" width="400" x="800" y="1330" as="geometry" />
        </mxCell>
        <mxCell id="467" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#666666;" value="채점 항목은 전부 nullable — 미입력은 0점이 아니라 결측이다.&#xa;영역 집계에서 제외 후 재정규화(기획 일지 §5)." vertex="1">
          <mxGeometry height="40" width="400" x="800" y="1370" as="geometry" />
        </mxCell>
        <mxCell id="468" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#666666;" value="UNIQUE(user_id, score_date) — 1인 1일 1행" vertex="1">
          <mxGeometry height="20" width="400" x="1520" y="970" as="geometry" />
        </mxCell>
        <mxCell id="469" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#666666;" value="기획이 저장을 요구하진 않는다. α(n) 의 영역별 기록 일수 · 7일 이동평균 ·&#xa;일지 0건인 day-0 점수가 요구하는 파생 캐시(read model)다.&#xa;scoring_version 은 scoring.* 설정값의 태그 — FK 아님." vertex="1">
          <mxGeometry height="60" width="400" x="1520" y="1010" as="geometry" />
